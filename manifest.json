{
  "name": "Folio — Markdown Editor",
  "short_name": "Folio",
  "description": "A distraction-free markdown editor",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#1a1a18",
  "theme_color": "#1a1a18",
  "orientation": "any",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["productivity", "utilities"],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt"]
      }
    }
  ]
}
